# Supabase project URL, for example: https://your-project.supabase.co
VITE_SUPABASE_URL=

# Supabase publishable/anon key used by the browser app.
# Prefer the newer publishable key when available.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional backwards-compatible alternative. The app uses this only when
# VITE_SUPABASE_PUBLISHABLE_KEY is not set.
# VITE_SUPABASE_ANON_KEY=
